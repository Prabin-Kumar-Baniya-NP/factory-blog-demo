<%- include('../partials/header') %>
    <h1><%= title %></h1>
<% if (errors.length > 0) { %>
    <ul class="error" role="alert">
<% errors.forEach((error) => { %>
      <li><%= error %></li>
<% }) %>
    </ul>
<% } %>
    <form method="post" action="<%= action %>" class="post-form">
      <p>
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= values.title %>" required>
      </p>
      <p>
        <label for="body">Body (Markdown)</label>
        <textarea id="body" name="body" rows="15" required><%= values.body %></textarea>
      </p>
      <p>
        <button type="submit"><%= submitLabel %></button>
        <a href="/admin">Cancel</a>
      </p>
    </form>
<% if (typeof post !== 'undefined' && post) { %>
    <p><a href="/posts/<%= post.slug %>">View post</a></p>
    <p class="notice">The post's URL (/posts/<%= post.slug %>) will not change when you edit the title.</p>
<% } %>
<%- include('../partials/footer') %>
